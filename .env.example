# LaTeX runs locally. Install Node dependencies and run npm run build.
# Optional override if Node is not on PATH:
# LATEX_NODE_BINARY=C:/Program Files/nodejs/node.exe

# Optional AI diagnosis endpoint. Use an OpenAI-compatible chat-completions URL.
# The feature remains available with deterministic analysis when this is empty.
# AI_ANALYSIS_API_URL=https://your-ai-provider.example/v1/chat/completions
# AI_ANALYSIS_API_KEY=replace-with-your-api-key
# AI_ANALYSIS_MODEL=your-json-capable-model
# AI_ANALYSIS_PROVIDER=your-provider-name
# AI_ANALYSIS_TIMEOUT_SECONDS=20
# AI_ANALYSIS_RETRIES=2
# AI_ANALYSIS_CACHE_HOURS=24
# Use a private random value so student references sent to AI cannot be guessed.
# AI_ANALYSIS_PSEUDONYM_SALT=replace-with-a-long-random-value

# Teacher-owned Gemini credentials (required before the AI settings page can
# save or use teacher keys). Keep both values stable across all web workers.
# FLASK_SECRET_KEY=replace-with-a-long-random-session-secret
# Generate the next value with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
# GEMINI_OPENAI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_GEMINI_TIMEOUT_SECONDS=20
# AI_GEMINI_MAX_HTTP_ATTEMPTS=2  # outbound calls, including transient retries
# AI_GEMINI_TRANSIENT_RETRIES=1
# AI_GEMINI_DEADLINE_SECONDS=45
# AI_GEMINI_PROJECT_COOLDOWN_SECONDS=60
# CLASS_REPORT_FALLBACK_RETRY_SECONDS=60
#
# Legacy single process key integration is OFF for teacher web requests. Set
# this only for an unassigned legacy course during migration; it never applies
# to a course with a selected/default teacher group and never crosses teachers.
# AI_LEGACY_ENV_FALLBACK_ENABLED=1

# Google sign-in (OAuth 2.0). The login/register Google buttons are hidden
# until both values are set. In Google Cloud Console, add this authorized
# redirect URI for your deployed domain:
#   https://<your-domain>/auth/google/callback
# Facebook is not wired yet; it will reuse the same SocialAccount table.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
